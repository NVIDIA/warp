# Normalize text files on commit to LF endings by default
* text=auto
# Make sure Windows batch files preserve CR/LF line endings, otherwise they may not be able to execute.  Windows
# batch files require a CR/LF for labels to work properly, otherwise they may fail when labels straddle 512-byte
# block boundaries.  This is important when files are downloaded through a zip archive that was authored on a
# Linux machine (the default behavior on GitHub)
*.bat text eol=crlf
*.cmd text eol=crlf
# Make sure shell scripts have LF line endings, even when checked out on a Windows client with autocrlf=true
*.sh text eol=lf
# CI build jobs on every platform save the version and generated files as artifacts, and the wheel packaging jobs
# use whichever copy GitLab extracts last, so every platform must check them out with the same line endings
VERSION.md text eol=lf
warp/config.py text eol=lf
warp/native/version.h text eol=lf
warp/native/exports.h text eol=lf
warp/__init__.pyi text eol=lf

# Store binary assets in Git LFS
*.nvdb.grid filter=lfs diff=lfs merge=lfs -text
*.usd filter=lfs diff=lfs merge=lfs -text
*.grid filter=lfs diff=lfs merge=lfs -text
*.nvdb filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text

# Exclude vendored code from project language stats
warp/native/nanovdb/** linguist-vendored
warp/native/cuBQL/** linguist-vendored
tools/** linguist-vendored
